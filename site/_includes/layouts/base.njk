<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and title != site.title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="stylesheet" href="/assets/style.css">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true"></span>
        <span>
          <span class="brand-dept">{{ site.department }}</span>
          <span class="brand-title">Meeting Minutes</span>
        </span>
      </a>
      <nav aria-label="Meeting types">
        <ul class="nav">
          <li><a href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>All</a></li>
          {%- for t in meetingTypes %}
          <li><a href="/types/{{ t.id }}/" {% if page.url == "/types/" + t.id + "/" or meetingType == t.id %}aria-current="page"{% endif %}>{{ t.name }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
      <div class="nav-picker" data-nav-picker hidden>
        <label for="nav-select">Meeting type</label>
        <select id="nav-select"></select>
      </div>
      <a class="add-link" href="/add/" {% if page.url == "/add/" %}aria-current="page"{% endif %}>+ Add minutes</a>
    </div>
  </header>
  <main id="main" class="wrap">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <p>Only minutes approved by their committee are published here. <a href="/feed.xml">Subscribe (Atom feed)</a> · <a href="{{ site.repo }}">Source on GitHub</a>{% if site.contact %} · Questions: <a href="mailto:{{ site.contact }}">{{ site.contact }}</a>{% endif %}</p>
    </div>
  </footer>
  <a href="/search-index.json" data-search-index hidden tabindex="-1" aria-hidden="true"></a>
  <script src="/assets/filter.js" defer></script>
  {%- if pageScript %}
  <script src="{{ pageScript }}" defer></script>
  {%- endif %}
</body>
</html>
